# PINBANK live integration
# Copy these keys into the server environment with the real values provided by PINBANK.

PINBANK_BASE_URL=
PINBANK_USERNAME=
PINBANK_PASSWORD=
PINBANK_REQUEST_ORIGIN=

# The PINBANK encrypted endpoints require an AES-128 key, exactly 16 bytes.
# If PINBANK provides KeyValue as the encryption key, use the same value here.
PINBANK_AES_KEY=
PINBANK_CODIGO_CANAL=

# Optional values, depending on the contract/account returned by PINBANK.
PINBANK_CODIGO_CLIENTE=
PINBANK_CODIGO_TERMO=
PINBANK_TOKEN_SEED=
PINBANK_AES_IV=

# Optional endpoint overrides. Keep empty to use the defaults from server/pinbank-client.ts.
PINBANK_TOKEN_PATH=
PINBANK_TERMS_PATH=
PINBANK_COMPANY_ONBOARDING_PATH=
PINBANK_UPLOAD_DOCUMENT_PATH=
PINBANK_DOCUMENT_STATUS_PATH=
PINBANK_DOCUMENT_INVENTORY_PATH=
PINBANK_REPLACE_DOCUMENT_PATH=
PINBANK_CREATE_BOLETO_PATH=
PINBANK_CREATE_SPLIT_BOLETO_PATH=
PINBANK_CREATE_PAYMENT_LINK_PATH=
PINBANK_CANCEL_BOLETO_PATH=
PINBANK_BOLETO_STATUS_PATH=
PINBANK_LIST_BOLETOS_PATH=
PINBANK_CHARGE_METRICS_PATH=
PINBANK_BALANCE_PATH=
PINBANK_STATEMENT_PATH=
PINBANK_TRANSACTION_RECEIPT_PATH=
