# Base nova, isolada da integração Asaas já existente. Sem valores reais.
ASAAS_BASE_ENABLED=false
ASAAS_BASE_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_SANDBOX_WEBHOOK_URL=https://app.builtalliances.com/api/webhooks/asaas/sandbox
# 32 bytes em base64 (ex.: openssl rand -base64 32). Nunca enviar ao navegador ou versionar valor real.
ASAAS_SANDBOX_CREDENTIAL_ENCRYPTION_KEY=
ASAAS_BAAS_ENABLED=false
# Opt-in separado para cobranças de aportes; homologar com dados fictícios.
ASAAS_CONTRIBUTIONS_ENABLED=false
ASAAS_TRANSFERS_ENABLED=false
ASAAS_PRODUCTION_OPERATIONS_ENABLED=false
# Chave PRÓPRIA da SPE/holding; credential_reference guarda só o nome da variável.
ASAAS_SANDBOX_ACCOUNT_EMPRESA_EXEMPLO=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_WEBHOOK_URL=https://app.example.com/api/webhooks/asaas/production
ASAAS_PRODUCTION_CREDENTIAL_ENCRYPTION_KEY=
# Produção exige credenciais próprias, autorização explícita e ação humana com dados reais autorizados.
# Não copiar ASAAS_API_KEY/ASAAS_WEBHOOK_TOKEN sem confirmar seu ambiente.
# Token de webhook deve ser exclusivo, diferente da chave de API.
